rules_version = '2';
// 한솔2(v2) 자료실 + CRM(crm/index.html) 고객서류함 공용 Firebase Storage 보안 규칙.
//
// [§Storage 연결 라운드에서 갱신] 이 파일은 원래(자료실 라운드) "게시할 곳이 없어" 주석 처리된
// 참고 문서였다. 이번 라운드에서 v2/index.html·crm/index.html 양쪽 모두 실제 uploadBytesResumable
// 코드가 이 규칙이 다루는 경로로 업로드를 시도하도록 연결했으므로, 이 파일도 실제 게시 가능한
// 활성 규칙 문법으로 바꿨다. 다만 이 샌드박스에는 여전히 실제 Storage 버킷/네트워크가 연결되어
// 있지 않다(BLOCKED — 아웃바운드 요청이 프록시에서 403으로 막힘) — 그래서 이 규칙을 실제로
// Firebase Console에 [게시]하는 것은 사용자가 직접 해야 한다(아래 안내 참고).
//
// v2/firestore.rules(현재 저장소에는 아직 없음 — users/{uid}/shin2/{docId} 패턴)와 동일한
// 원칙을 그대로 따른다: 로그인한 사용자가 "자기 자신의 uid" 아래 경로에만 읽기/쓰기가 가능.
//
// ---- 이 규칙이 다루는 경로 ----
// - 자료실:   users/{uid}/library/{fileId}/{fileName}
// - CRM 서류함: users/{uid}/customers/{companyId}/documents/{documentId}/{fileName}
// 둘 다 users/{userId}/** 아래에 있으므로 match 블록 하나로 함께 커버된다(경로가 서로
// 겹치지 않게 자료실은 library/, CRM은 customers/.../documents/ 하위 세그먼트로 완전히 분리).
//
// ---- Firebase Console에서 이 규칙을 실제로 켜는 절차(수동, 코드로 불가능한 부분) ----
// 1. Firebase Console → Storage → 시작하기(버킷이 아직 없다면 생성).
// 2. Storage → Rules 탭에 아래 규칙 본문을 그대로 붙여넣고 [게시].
// 3. firebase.json의 "storage.rules"가 이 파일(v2/storage.rules)을 가리키고 있으므로,
//    `firebase deploy --only storage`로도 배포할 수 있다(CLI/Console 둘 중 편한 쪽 사용).

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
