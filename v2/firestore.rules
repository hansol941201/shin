rules_version = '2';
// 한솔2(v2) 전용 Firestore 보안 규칙.
// Firebase Console → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 [게시]하세요.
//
// 이 규칙은 로그인한 사용자가 "자기 자신의 uid" 아래 문서에만 읽기/쓰기가 가능하도록
// 제한한다 — 다른 사람이 URL을 알아도 남의 데이터를 읽거나 쓸 수 없다.
//
// 주의: 이 규칙은 한솔2(v2, users/{uid}/shin2/*)에만 적용된다. 기존 한솔(root)이
// 쓰는 컬렉션들(예: companies, workflow, todo 등 최상위 컬렉션)의 열린 규칙
// ("allow read, write: if true")은 이 파일이 건드리지 않는다 — 두 규칙을 합쳐서
// 게시해야 한솔(root)과 한솔2(v2)가 동시에 정상 동작한다. 아래 "합쳐서 게시할 전체 예시"를
// 참고하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 한솔2(v2): 로그인한 본인의 uid 아래 문서만 읽기/쓰기 허용 ----
    match /users/{uid}/shin2/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- 참고: 기존 한솔(root)이 쓰는 컬렉션 — 이미 콘솔에 게시되어 있을 규칙.
    // 아래 컬렉션 이름과 실제 프로젝트의 기존 규칙이 다르면, 기존 것을 그대로 두고
    // 위의 users/{uid}/shin2/{docId} match 블록만 추가해주세요.
    match /{collection}/{doc} {
      allow read, write: if collection in [
        'companies', 'workflow', 'todo', 'accounts', 'shortcuts',
        'phrases', 'settings', 'jurisdictions', 'materials', 'sites',
        'workItems', 'callLogs', 'phoneQuestionSets', 'phoneProcedureSets'
      ];
    }
  }
}
