{
  "name": "pour-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "POUR 시공사 대상 B2B 홍보영상 렌더러 (HTML/CSS 모션 + Playwright 프레임 캡처 + ffmpeg)",
  "scripts": {
    "setup": "npm i && mkdir -p fonts && cp node_modules/pretendard/dist/web/static/woff2/*.woff2 fonts/",
    "render": "node render.js",
    "probe": "node probe.js",
    "audit": "node audit.js",
    "render:v9": "FILM=film2.html OUT=POUR_홍보영상_v9_라이트.mp4 node render.js",
    "audit:v9": "FILM=film2.html node audit.js",
    "luma": "FILM=film2.html node luma.js",
    "subcheck": "FILM=film2.html node subcheck.js",
    "cutout": "node cutout.js"
  },
  "dependencies": {
    "image-size": "1.1.1",
    "playwright": "1.55.0",
    "pretendard": "1.3.9"
  }
}