rules_version = '2';

// team-schedule-app 공동 일정 저장소 보안 규칙.
//
// 읽기: 누구나 가능(로그인 없이 팀원들이 바로 일정을 볼 수 있어야 함).
// 쓰기: 클라이언트에서는 전부 금지한다 — 모든 쓰기는 Cloud Functions가
// Admin SDK로 대신 하고(규칙을 우회함), 그 함수들은 "편집 코드"로 발급된
// editTokens 문서를 매번 확인한다. 즉 이 규칙은 "클라이언트가 Firestore를
// 직접 건드릴 수 없다"만 보장하면 되고, 실제 권한 검증은 Cloud Functions
// 쪽(functions/index.js의 assertEditToken)에서 이뤄진다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /googleEventsCache/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // editTokens는 서버(Admin SDK)만 읽고 쓴다 — 토큰 값을 알아도 클라
    // 이언트가 직접 열람/생성할 수 없게 막는다(Admin SDK는 이 규칙 자체를
    // 건너뛰므로 서버 쪽 동작에는 영향 없음).
    match /editTokens/{token} {
      allow read, write: if false;
    }
  }
}
